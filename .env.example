OTP_DB_USERNAME=root
OTP_DB_PASSWORD=your_database_password

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=your-email@gmail.com
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

SQLSERVER_USERNAME=sa
SQLSERVER_PASSWORD=your_sqlserver_password #Mật khẩu phải trên 8 ký tự và có 1 ký tự đặc biệt, 1 chữ viết hoa

INTERNAL_SERVICE_TOKEN=your_internal_service_token

# MongoDB connection URL sử dụng hostname của MongoDB service trong Docker network.
# URL mặc định, không chứa thông tin xác thực nên có thể công khai trong .env.example.
MONGO_URL=mongodb://<username>:<password>@<host>:27017/payment_system

JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem